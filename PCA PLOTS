

# ==============================================================================
# LABORATORY WORK: METABOLOMICS PCA PLOT PROFILE
# ==============================================================================

# 1. LOAD REQUIRED LIBRARIES
# ------------------------------------------------------------------------------
library(stats)
library(ggplot2)

# 2. FILE IMPORT AND VIEW
# ------------------------------------------------------------------------------
# Opens an interactive pop-up window to cleanly select your CSV file
c <- read.csv(file.choose(), row.names = NULL)
print(c)

# 3. DATA EXTRACTION & INTEGRITY CHECK
# ------------------------------------------------------------------------------
muestra <- c[[1]]
num     <- c[, -1]

# Automatically isolate numeric variables and remove missing/empty metrics
num     <- num[, sapply(num, is.numeric)]
ok      <- complete.cases(num)
num     <- num[ok, ]
muestra <- muestra[ok]

# 4. COMPUTE PRINCIPAL COMPONENTS ANALYSIS (PCA)
# ------------------------------------------------------------------------------
pca     <- prcomp(num, scale. = TRUE)
var_exp <- round(100 * pcasdev2/sum(pcasdev^2), 1)

# Compile results into organized summary tables
scores  <- data.frame(pca$x, muestra = muestra)
tabla   <- data.frame(muestra = muestra, pca$x)
print(tabla)

# 5. VISUALIZATION SYSTEM (NEAT MINIMALIST STYLE)
# ------------------------------------------------------------------------------
ggplot(scores, aes(x = PC1, y = PC2, color = muestra)) +
  geom_point(size = 3, alpha = 0.8) +
  stat_ellipse(level = 0.95, size = 0.8, linetype = "solid") +
  labs(
    title    = "Metabolomics Cluster Analysis",
    subtitle = "Principal Component Analysis Profile (Arabica vs. Robusta)",
    x        = paste0("PC1 (", var_exp[1], "%)"),
    y        = paste0("PC2 (", var_exp[2], "%)"),
    color    = "Coffee Group"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    plot.title       = element_text(face = "bold", size = 14, margin = margin(b = 5)),
    plot.subtitle    = element_text(color = "#555555", size = 10, margin = margin(b = 15)),
    axis.title       = element_text(face = "bold"),
    panel.grid.minor = element_blank(),
    legend.position  = "right"
  )

