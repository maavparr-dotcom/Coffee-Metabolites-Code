> # ---- 2. Flexible Read Function ----------------------------------------------
> read_raw <- function(file, class_label) {
+    if (!file.exists(file)) {
+        stop(paste("Could not find file:", file))
+    }
+    lines <- readLines(file, warn = FALSE, encoding = "UTF-8")
+    lines <- sub("^\ufeff", "", lines)
+    lines <- lines[nzchar(trimws(gsub("[,\t]", "", lines)))]   # drop empty lines
+    
+    is_header <- grepl("\\.fid", lines, ignore.case = TRUE)
+    spec_name <- sub("[,\t].*$", "", lines[is_header])         # file name of each spectrum
+    spec_id   <- cumsum(is_header)
+    
+    body  <- lines[!is_header]
+    idx   <- spec_id[!is_header]
+    parts <- strsplit(body, "[\t,]")                           # file is tab- or comma-separated
+    
+    # Helper to safely extract parts
+    get <- function(i) vapply(parts, function(x) if (length(x) >= i) x[i] else NA_character_, "")
+    
+    # Check if first column is text (class) or numeric (ppm)
+    first_val <- suppressWarnings(as.numeric(get(1)))
+    is_class_first <- all(is.na(first_val))
+    
+    if (is_class_first) {
+        data.frame(
+            class      = class_label,
+            file       = spec_name[idx],
+            ppm        = suppressWarnings(as.numeric(get(2))),
+            intensity  = suppressWarnings(as.numeric(get(3))),
+            width      = suppressWarnings(as.numeric(get(4))),
+            area       = suppressWarnings(as.numeric(get(5))),
+            peak_class = get(1),
+            stringsAsFactors = FALSE
+        )
+    } else {
+        data.frame(
+            class      = class_label,
+            file       = spec_name[idx],
+            ppm        = suppressWarnings(as.numeric(get(1))),
+            intensity  = suppressWarnings(as.numeric(get(2))),
+            width      = suppressWarnings(as.numeric(get(3))),
+            area       = suppressWarnings(as.numeric(get(4))),
+            peak_class = get(5),
+            stringsAsFactors = FALSE
+        )
+    }
+ }
