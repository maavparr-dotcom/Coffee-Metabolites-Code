> # Short, unique spectrum labels
> short_label <- function(cls, file) {
+    day  <- sub("^\\d{4}-\\d{2}-(\\d{2})-.*$", "\\1", file)
+    name <- sub("^\\d{4}-\\d{2}-\\d{2}-chem124-", "", file, ignore.case = TRUE)
+    name <- sub("\\.fid$", "", name, ignore.case = TRUE)
+    name <- sub("\\.\\d+$", "", name)
+    paste0(toupper(substr(cls, 1, 1)), ":", name, "@", day)
+ }
> peaks <- peaks %>% mutate(spectrum = short_label(class, file))
